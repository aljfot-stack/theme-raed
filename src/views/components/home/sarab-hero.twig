<section component-id="{{ componentId }}" data-testid="sarab-hero" class="sarab-hero{% if component.image or component.video %} has-image{% endif %}">
  {% if component.video %}
    <video class="sarab-hero__bg" src="{{ component.video }}" {% if component.image %}poster="{{ component.image }}"{% endif %} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
    <span class="sarab-hero__scrim" aria-hidden="true"></span>
  {% elseif component.image %}
    <img class="sarab-hero__bg" src="{{ component.image }}" alt="" loading="eager" fetchpriority="high">
    <span class="sarab-hero__scrim" aria-hidden="true"></span>
  {% endif %}
  <div class="container sarab-hero__inner">
    <div class="sarab-hero__pills sarab-rise">
      {% if component.eyebrow %}<span class="sarab-pill">{{ component.eyebrow }}</span>{% endif %}
      {% if component.eyebrow2 %}<span class="sarab-pill">{{ component.eyebrow2 }}</span>{% endif %}
    </div>
    <h1 class="sarab-hero__title sarab-rise sarab-rise--2">
      {{ component.title }}
      {% if component.title_gold %}<span class="sarab-gold">{{ component.title_gold }}</span>{% endif %}
    </h1>
    <div class="sarab-hero__bottom sarab-rise sarab-rise--3">
      {% if component.subtitle %}<p class="sarab-hero__subtitle">{{ component.subtitle }}</p>{% endif %}
      <div class="sarab-hero__actions">
        {% if component.btn_text and component.btn_link %}
          <a class="sarab-btn sarab-btn--gold" href="{{ component.btn_link }}">{{ component.btn_text }}</a>
        {% endif %}
        {% if component.btn2_text and component.btn2_link %}
          <a class="sarab-btn sarab-btn--ghost" href="{{ component.btn2_link }}">{{ component.btn2_text }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>
